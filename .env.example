# Telegram Bot Settings
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=-100xxxxxxxxxx
ADMIN_USERNAMES=@yourusername,@admin2
ADMIN_USER_IDS=12345678,98765432

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Neon Database Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dvbot_user
DB_PASS=your_password
DB_NAME=dv_bot_db
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# Storage (S3 / Neon Object Storage)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint
AWS_REGION=us-east-1
